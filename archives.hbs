{{!< default}}

{{!-- このファイルはHTML、CSS、JSを1つにまとめていますが、実際には .hbs、.css、.js ファイルに分けてください --}}
<style>
    /* ==========================================================================
       Variables (実際のサイトの変数に合わせてください)
       ========================================================================== */
    :root {
        --color-text: #2a3f4a;
        --color-text-secondary: #5a6f7a;
        --color-text-tertiary: #8a9aa5;
        --color-border: #d0dfe5;
        --color-border-hover: #b0c5d0;
        --color-bg: #f8fcfb;
        --color-bg-alt: #fff;
    }
    .dark-mode {
        --color-text: #d0dfe5;
        --color-text-secondary: #9aacb5;
        --color-text-tertiary: #7a8f9a;
        --color-border: #3a4f5a;
        --color-border-hover: #5a6f7a;
        --color-bg: #1a2428;
        --color-bg-alt: #202c31;
    }
    body {
        background-color: var(--color-bg);
        color: var(--color-text);
        /* ★★★ フッターが浮く問題の修正 ★★★ */
        /* このスタイルは default.hbs や共通のCSSファイルに適用するのが理想的です */
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
    /* default.hbs内のメインコンテンツを囲む要素を想定 */
    .site-main {
        flex-grow: 1; /* メインコンテンツが利用可能なスペースを埋めるようにする */
    }


    /* ==================================
       Archive Page Layout
       ================================== */
    .archive-template {
        font-family: 'Noto Sans JP', sans-serif;
    }
    .page-header {
        padding: 100px 40px 60px;
        text-align: center;
    }
    .page-header-inner {
        max-width: 800px;
        margin: 0 auto;
    }
    .page-title {
        font-family: 'DotGothic16', monospace;
        font-size: 2.5rem;
        font-weight: 400;
        color: var(--color-text);
        letter-spacing: 0.1em;
        margin: 0 0 10px;
    }
    .page-description {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--color-text-secondary);
        max-width: 600px;
        margin: 0 auto;
    }

    /* --- Filters --- */
    .archive-filters {
        max-width: 1000px;
        margin: 0 auto 60px;
        padding: 0 40px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .search-input-wrapper {
        position: relative;
    }
    .search-input {
        width: 100%;
        padding: 12px 20px 12px 45px;
        border: 1px solid var(--color-border);
        border-radius: 30px;
        background-color: var(--color-bg-alt);
        color: var(--color-text);
        font-size: 1rem;
        transition: border-color 0.3s ease;
    }
    .search-input:focus {
        outline: none;
        border-color: var(--color-border-hover);
    }
    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        color: var(--color-text-tertiary);
    }
    .tag-filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }
    .tag-filter-btn {
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 20px;
        padding: 6px 16px;
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .tag-filter-btn:hover {
        border-color: var(--color-border-hover);
        color: var(--color-text);
    }
    .tag-filter-btn.is-active {
        background-color: var(--color-text);
        color: var(--color-bg);
        border-color: var(--color-text);
    }

    /* --- Archive List --- */
    .archive-list-section {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 40px 80px;
    }
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 5px;
        top: 10px;
        bottom: 10px;
        width: 2px;
        background-color: var(--color-border);
    }
    .timeline-group {
        margin-bottom: 40px;
        position: relative;
    }
    .timeline-group:last-child {
        margin-bottom: 0;
    }
    .timeline-year {
        font-family: 'DotGothic16', monospace;
        font-size: 1.8rem;
        color: var(--color-text);
        margin-bottom: 20px;
        position: relative;
    }
    .timeline-year::before {
        content: '';
        position: absolute;
        left: -32px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        background-color: var(--color-bg);
        border: 3px solid var(--color-text-secondary);
        border-radius: 50%;
    }
    .post-item {
        display: block;
        padding: 15px 0;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        transition: background-color 0.3s ease;
        margin-left: -30px;
        padding-left: 30px;
    }
    .post-item:hover {
        background-color: rgba(0,0,0,0.02);
    }
    .dark-mode .post-item:hover {
        background-color: rgba(255,255,255,0.03);
    }
    .post-item-content {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }
    .post-item-date {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        flex-shrink: 0;
        width: 80px;
    }
    .post-item-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-text);
        flex-grow: 1;
    }
    .post-item-tags {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }
    .post-item-tag {
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        background-color: rgba(0,0,0,0.05);
        padding: 3px 10px;
        border-radius: 12px;
    }
    .dark-mode .post-item-tag {
        background-color: rgba(255,255,255,0.08);
    }

    /* --- Loading Indicator --- */
    .loading-indicator {
        text-align: center;
        padding: 40px;
        display: none;
        opacity: 0;
    }
    .loading-indicator.is-visible {
        display: block;
        opacity: 1;
    }
    .loader {
        border: 4px solid var(--color-border);
        border-top: 4px solid var(--color-text-secondary);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }
    @keyframes spin { 100% { transform: rotate(360deg); } }

    /* --- レスポンシブ --- */
    @media (max-width: 768px) {
        .page-header { padding: 80px 20px 40px; }
        .archive-filters, .archive-list-section { padding: 0 20px 60px; }
        .post-item-content { flex-direction: column; align-items: flex-start; gap: 10px; }
        .post-item-date { width: auto; }
    }
</style>

<div class="archive-template">

    <header class="page-header">
        <div class="page-header-inner">
            <h1 class="page-title">Archives</h1>
            <p class="page-description">
                これまでに紡いできた、すべての言葉と思索の記録です。<br>
                タグやキーワードで、過去の断片を自由に散策できます。
            </p>
        </div>
    </header>

    <div class="archive-filters">
        <div class="search-input-wrapper">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
            <input type="search" id="search-input" class="search-input" placeholder="キーワードで検索...">
        </div>
        <div id="tag-filters" class="tag-filters">
            <button class="tag-filter-btn is-active" data-slug="all">All Tags</button>
            {{#get "tags" limit="all"}}
                {{#foreach tags}}
                    <button class="tag-filter-btn" data-slug="{{slug}}">{{name}}</button>
                {{/foreach}}
            {{/get}}
        </div>
    </div>

    <section class="archive-list-section">
        <div id="archive-timeline" class="timeline">
            {{!-- 投稿はJavaScriptで動的に読み込まれます --}}
        </div>
        <div id="loading-indicator" class="loading-indicator">
            <div class="loader"></div>
        </div>
    </section>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // --- DOM Elements ---
    const timeline = document.getElementById('archive-timeline');
    const loadingIndicator = document.getElementById('loading-indicator');
    const searchInput = document.getElementById('search-input');
    const tagFilters = document.getElementById('tag-filters');

    // --- Ghost API Settings ---
    const apiKey = window.GHOST_API_KEY || '2ab3404520b90d08c024630c86'; // APIキーを直接記述
    const apiURL = window.location.origin;

    // --- State ---
    let currentPage = 1;
    let isLoading = false;
    let allPostsLoaded = false;
    let currentFilter = { tag: 'all', search: '' };
    let currentYearMonth = null;

    // --- Functions ---

    // 投稿アイテムのHTMLを生成
    const createPostItem = (post) => {
        const date = new Date(post.published_at);
        const day = String(date.getDate()).padStart(2, '0');
        const title = post.title;
        const tagsHtml = post.tags.map(tag => `<span class="post-item-tag">${tag.name}</span>`).join('');
        
        return `
            <a href="${post.url}" class="post-item">
                <div class="post-item-content">
                    <span class="post-item-date">${day}日</span>
                    <h3 class="post-item-title">${title}</h3>
                    <div class="post-item-tags">${tagsHtml}</div>
                </div>
            </a>
        `;
    };

    // 年月のヘッダーを生成
    const createYearMonthHeader = (date) => {
        const year = date.getFullYear();
        const month = date.toLocaleString('ja-JP', { month: 'long' });
        const groupId = `${year}-${date.getMonth()}`;
        return `
            <div class="timeline-group" data-group-id="${groupId}">
                <h2 class="timeline-year">${year}年 ${month}</h2>
            </div>
        `;
    };

    // 投稿をタイムラインに追加
    const appendPosts = (posts) => {
        posts.forEach(post => {
            const postDate = new Date(post.published_at);
            const postYear = postDate.getFullYear();
            const postMonth = postDate.getMonth();
            const yearMonthId = `${postYear}-${postMonth}`;

            if (currentYearMonth !== yearMonthId) {
                currentYearMonth = yearMonthId;
                timeline.insertAdjacentHTML('beforeend', createYearMonthHeader(postDate));
            }
            
            const currentGroup = timeline.querySelector(`.timeline-group[data-group-id="${yearMonthId}"]`);
            if(currentGroup) {
                 currentGroup.insertAdjacentHTML('beforeend', createPostItem(post));
            }
        });
    };

    // 投稿をAPIから読み込む
    const loadPosts = async () => {
        if (isLoading || allPostsLoaded) return;
        isLoading = true;
        loadingIndicator.classList.add('is-visible');

        let filterParam = '';
        if (currentFilter.tag !== 'all') {
            filterParam = `&filter=tags:${currentFilter.tag}`;
        }

        try {
            // ★★★ APIエラー修正点 ★★★
            // APIのパスにバージョンを追加 (v3, v4, v5など。v3は互換性が高い)
            const url = `${apiURL}/ghost/api/v3/content/posts/?key=${apiKey}${filterParam}&limit=15&page=${currentPage}&include=tags&order=published_at%20desc`;
            const response = await fetch(url);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();

            if (data.posts && data.posts.length > 0) {
                const filteredPosts = data.posts.filter(post => 
                    post.title.toLowerCase().includes(currentFilter.search.toLowerCase())
                );
                appendPosts(filteredPosts);
                currentPage++;
            } else {
                allPostsLoaded = true;
            }

        } catch (error) {
            console.error('Error fetching posts:', error);
            allPostsLoaded = true;
        } finally {
            isLoading = false;
            loadingIndicator.classList.remove('is-visible');
        }
    };

    // フィルタが変更された時のリセット処理
    const resetAndLoad = () => {
        timeline.innerHTML = '';
        currentPage = 1;
        allPostsLoaded = false;
        currentYearMonth = null;
        loadPosts();
    };

    // --- Event Listeners ---

    tagFilters.addEventListener('click', (e) => {
        if (e.target.matches('.tag-filter-btn')) {
            tagFilters.querySelector('.is-active').classList.remove('is-active');
            e.target.classList.add('is-active');
            currentFilter.tag = e.target.dataset.slug;
            resetAndLoad();
        }
    });

    let searchTimeout;
    searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            currentFilter.search = searchInput.value;
            resetAndLoad();
        }, 500);
    });

    window.addEventListener('scroll', () => {
        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 500) {
            loadPosts();
        }
    });

    // --- Initial Load ---
    loadPosts();
});
</script>
