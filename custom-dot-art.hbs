{{!< default}}
{{! 
  このテンプレートは「ドットアート」投稿用です。
  使い方：
  1. ドットアート画像を「フィーチャー画像 (Feature Image)」に設定します。
  2. この投稿に「dot-art」などの専用タグを付けます。（関連記事表示に必要）
  3. 投稿設定の「テンプレート」から「Dot Art」を選択します。
}}

{{#post}}
<main id="site-main" class="site-main">
    <article class="art-article {{post_class}}">

        {{#if feature_image}}
            <figure class="art-feature-image">
                <img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
            </figure>
        {{/if}}

        <header class="art-header gh-canvas">
            <h1 class="art-title">{{title}}</h1>
            {{! --- 投稿日時を追加 --- }}
            <div class="art-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY年M月D日"}}</time>
            </div>
            {{#if custom_excerpt}}
                <p class="art-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        </header>


        {{! --- デフォルトテンプレートのCSSを引き継ぐためにクラス名を変更 --- }}
        <section class="post-full-content gh-content">
            {{{content}}}
        </section>


    </article>

    {{! --- 関連記事（同じタグを持つ他のドットアート作品） --- }}
    {{#get "posts" filter="tags:dot-art+id:-{{id}}" limit="9" as |related_posts|}}
        {{#if related_posts}}
            <section class="related-art-section gh-canvas">
                <h2 class="related-art-title">You might also like...</h2>
                <div class="related-art-grid">
                    {{#foreach related_posts}}
                        <a href="{{url}}" class="related-art-item">
                            {{#if feature_image}}
                                <img src="{{feature_image}}" alt="{{title}}" loading="lazy" />
                            {{/if}}
                            {{! --- ホバー時に表示する情報を追加 --- }}
                            <div class="related-art-info">
                                <h3 class="related-art-item-title">{{title}}</h3>
                                <time class="related-art-item-date">{{date format="YYYY.MM.DD"}}</time>
                            </div>
                        </a>
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}

</main>
{{/post}}

<style>
/* ==========================================================================
   Custom Template: Dot Art - Refined Version
   ========================================================================== */

/* --- 1. メインのアート表示エリア --- */
.art-article {
    padding-top: 5vw; /* 上部に少し余白を追加 */
}

/* フィーチャー画像: 表示幅を画面の70%に制限し、中央に配置 */
.art-feature-image {
    max-width: 70vw;
    margin: 0 auto 5vw; /* 上下 | 左右 */
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1); /* 繊細な影を追加 */
}
.art-feature-image img {
    display: block;
    width: 100%;
    height: auto;
}

/* ヘッダー: タイトル、日付、抜粋 */
.art-header {
    text-align: center;
    margin-bottom: 4vw;
}

.art-title {
    font-family: 'DotGothic16', sans-serif; 
    font-size: clamp(1.8rem, 4vw, 2.5rem); /* レスポンシブなフォントサイズ */
    font-weight: 400;
    letter-spacing: 0.1em;
    color: #4a4a4a;
    margin: 0 0 1rem;
}

/* 新しく追加した日付のスタイル */
.art-meta {
    font-family: sans-serif;
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 1.5rem;
}

.art-excerpt {
    font-size: 1rem;
    color: #7d7d7d;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.7;
}

/* 本文エリア (.post-full-content)
  このクラスはデフォルトテンプレートのCSSを継承するため、
  このテンプレート特有の上書きがなければ、ここでの追加CSSは不要です。
*/

.post-full-content {
    max-width: 800px; /* コンテンツの最大幅を設定 */
    margin-left: auto;
    margin-right: auto;
}


/* --- 2. 関連記事セクション (メイソンリーギャラリー) --- */
.related-art-section {
    padding-top: 5vw;
    margin-top: 5vw;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

.related-art-title {
    text-align: center;
    font-size: 1.2rem;
    color: #7d7d7d;
    font-weight: 400;
    margin-bottom: 40px;
}

.related-art-grid {
    column-count: 3;
    column-gap: 20px;
}

.related-art-item {
    position: relative; /* 子要素を絶対配置するための基準 */
    display: inline-block;
    width: 100%;
    margin-bottom: 20px;
    break-inside: avoid; /* 画像がカラム間で分割されるのを防ぐ */
    overflow: hidden; /* はみ出した要素を隠す */
    border-radius: 4px; /* 画像の角丸に合わせる */
}

.related-art-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease; /* ホバー時のズーム効果 */
}

/* ホバー効果: 画像を少し拡大 */
.related-art-item:hover img {
    transform: scale(1.05);
}

/* ホバー効果: 白いオーバーレイ */
.related-art-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.5); /* 半透明の白 */
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1; /* 画像の上 */
}

.related-art-item:hover::before {
    opacity: 1;
}

/* ホバー時に表示される情報ボックス */
.related-art-info {
    position: absolute;
    bottom: 0;
    right: 0; /* 右下に配置 */
    width: 100%;
    padding: 20px 15px 15px;
    color: #fff;
    z-index: 2; /* オーバーレイの上 */
    text-align: right; /* テキストを右揃えに */
    
    /* 可読性を上げるためのグラデーション背景 */
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    
    /* デフォルトでは非表示、ホバーで表示 */
    opacity: 0;
    transform: translateY(10px); /* 少し下からスライドイン */
    transition: opacity 0.4s ease, transform 0.4s ease;
}

.related-art-item:hover .related-art-info {
    opacity: 1;
    transform: translateY(0);
}

.related-art-item-title {
    font-family: 'DotGothic16', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    margin: 0 0 5px;
    color: #fff;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.7); /* 文字の影を濃くして可読性を確保 */
}

.related-art-item-date {
    font-family: sans-serif;
    font-size: 0.75rem;
    color: #fff;
    opacity: 0.8;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
}


/* --- 3. レスポンシブ & ダークモード対応 --- */
@media (max-width: 992px) {
    .related-art-grid {
        column-count: 2;
    }
}
@media (max-width: 767px) {
    .art-feature-image {
        max-width: 90vw; /* スマホでは画像の表示領域を少し広げる */
    }
    .art-title {
        font-size: 1.8rem;
    }
    .related-art-grid {
        column-count: 2;
    }

    .related-art-item {
        margin-bottom: 10px; /* スマホでは間隔を狭く */
    }
}

.dark-mode .art-title,
.dark-mode .art-excerpt,
.dark-mode .related-art-title {
    color: #b0b0b0;
}
.dark-mode .art-meta {
    color: #8a8a8a;
}
.dark-mode .related-art-section {
    border-top-color: rgba(255, 255, 255, 0.1);
}
.dark-mode .related-art-item::before {
    background: rgba(0, 0, 0, 0.4); /* ダークモードでは黒いオーバーレイ */
}

</style>
