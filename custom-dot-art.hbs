{{!< default}}
{{! 
  このテンプレートは「ドットアート」投稿用です。
  使い方：
  1. ドットアート画像を「フィーチャー画像 (Feature Image)」に設定します。
  2. この投稿に「dot-art」などの専用タグを付けます。（関連記事表示に必要）
  3. 投稿設定の「テンプレート」から「Dot Art」を選択します。
}}

{{#post}}
<main id="site-main" class="site-main">
    <article class="art-article {{post_class}}">

        {{#if feature_image}}
            <figure class="art-feature-image">
                <img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
            </figure>
        {{/if}}

        <header class="art-header gh-canvas">
            <h1 class="art-title">{{title}}</h1>
            {{! --- 投稿日時を追加 --- }}
            <div class="art-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY年M月D日"}}</time>
            </div>
            {{#if custom_excerpt}}
                <p class="art-excerpt">{{custom_excerpt}}</p>
            {{/if}}
        </header>


        {{! --- デフォルトテンプレートのCSSを引き継ぐためにクラス名を変更 --- }}
        <section class="post-full-content gh-content">
            {{{content}}}
        </section>
    </article>

    {{!-- Tips/寄付セクション --}}
    <section class="support-section">
        
        <!-- アイコンをFont AwesomeからインラインSVGに変更 -->
        <svg class="support-icon-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>

        <h3 class="support-title">この記事は参考になりましたか？</h3>
        <p class="support-description">
            もしこの記事が役に立ったら、サポートをご検討ください。<br>
            あなたの支援により、より良いコンテンツを作り続けることができます。
        </p>
        
        <a href="/#/portal/support" class="support-btn">
            <!-- ボタン内のアイコンもSVGに変更 -->
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
            </svg>
            <span>サポートする</span>
        </a>

    </section>

    {{!-- コメント欄 --}}
    {{#if comments}}
        <section class="article-comments">
            <div class="article-comments-container">
                <h2 class="article-comments-title">GUEST BOOK</h2>
                <div class="article-comments-meta">
                    {{! コメント数をシンプルに表示 }}
                    {{comment_count singular="1 Comment" plural="% Comments" empty="No Comments Yet" autowrap="span" class="comment-count-text"}}
                </div>
                
                {{! Ghostのコメント機能本体（タイトルとカウントは非表示に） }}
                {{comments title="" count=false}}
            </div>
        </section>
    {{/if}}

    {{! --- 関連記事（同じタグを持つ他のドットアート作品） --- }}
    {{#get "posts" filter="tags:dot-art+id:-{{id}}" limit="9" as |related_posts|}}
        {{#if related_posts}}
            <section class="related-art-section gh-canvas">
                <h2 class="related-art-title">You might also like...</h2>
                <div class="related-art-grid">
                    {{#foreach related_posts}}
                        <a href="{{url}}" class="related-art-item" data-published="{{date format="YYYY-MM-DDTHH:mm:ss.SSSZ"}}">
                            {{#if feature_image}}
                                <img src="{{feature_image}}" alt="{{title}}" loading="lazy" />
                            {{/if}}
                            {{! --- ホバー時に表示する情報を追加 --- }}
                            <div class="related-art-info">
                                <h3 class="related-art-item-title">{{title}}</h3>
                                <time class="related-art-item-date">{{date format="YYYY.MM.DD"}}</time>
                            </div>
                        </a>
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}

</main>
{{/post}}

<style>
/* ==========================================================================
   Custom Template: Dot Art - Refined Version
   ========================================================================== */

/* --- 1. メインのアート表示エリア --- */
.art-article {
    padding-top: 5vw; /* 上部に少し余白を追加 */
}

/* フィーチャー画像: 表示幅を画面の70%に制限し、中央に配置 */
.art-feature-image {
    max-width: 70vw;
    margin: 0 auto 5vw; /* 上下 | 左右 */
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1); /* 繊細な影を追加 */
}
.art-feature-image img {
    display: block;
    width: 100%;
    height: auto;
}

/* ヘッダー: タイトル、日付、抜粋 */
.art-header {
    text-align: center;
    margin-bottom: 4vw;
}

.art-title {
    font-family: 'DotGothic16', sans-serif; 
    font-size: clamp(1.8rem, 4vw, 2.5rem); /* レスポンシブなフォントサイズ */
    font-weight: 400;
    letter-spacing: 0.1em;
    color: #4a4a4a;
    margin: 0 0 1rem;
}

/* 新しく追加した日付のスタイル */
.art-meta {
    font-family: sans-serif;
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 1.5rem;
}

.art-excerpt {
    font-size: 1rem;
    color: #7d7d7d;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.7;
}

/* 本文エリア (.post-full-content)
  このクラスはデフォルトテンプレートのCSSを継承するため、
  このテンプレート特有の上書きがなければ、ここでの追加CSSは不要です。
*/

.post-full-content {
    max-width: 800px; /* コンテンツの最大幅を設定 */
    margin-left: auto;
    margin-right: auto;
}


/* --- 2. 関連記事セクション (メイソンリーギャラリー) --- */
.related-art-section {
    padding-top: 5vw;
    margin-top: 5vw;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

.related-art-title {
    text-align: center;
    font-size: 1.2rem;
    color: #7d7d7d;
    font-weight: 400;
    margin-bottom: 40px;
}

.related-art-grid {
    column-count: 3;
    column-gap: 20px;
}

.related-art-item {
    position: relative; /* 子要素を絶対配置するための基準 */
    display: inline-block;
    width: 100%;
    margin-bottom: 20px;
    break-inside: avoid; /* 画像がカラム間で分割されるのを防ぐ */
    overflow: hidden; /* はみ出した要素を隠す */
    border-radius: 4px; /* 画像の角丸に合わせる */
}

.related-art-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s ease; /* ホバー時のズーム効果 */
}

.related-art-item:hover img {
    transform: scale(1.05);
}

.related-art-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.5); /* 半透明の白 */
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1; /* 画像の上 */
}

.related-art-item:hover::before {
    opacity: 1;
}

.related-art-info {
    position: absolute;
    bottom: 0;
    right: 0; /* 右下に配置 */
    width: 100%;
    padding: 20px 15px 15px;
    color: #fff;
    z-index: 2; /* オーバーレイの上 */
    text-align: right; /* テキストを右揃えに */
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    opacity: 0;
    transform: translateY(10px); /* 少し下からスライドイン */
    transition: opacity 0.4s ease, transform 0.4s ease;
}

.related-art-item:hover .related-art-info {
    opacity: 1;
    transform: translateY(0);
}

.related-art-item-title {
    font-family: 'DotGothic16', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    margin: 0 0 5px;
    color: #fff;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
}

.related-art-item-date {
    font-family: sans-serif;
    font-size: 0.75rem;
    color: #fff;
    opacity: 0.8;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
}


/* --- 3. レスポンシブ & ダークモード対応 --- */
@media (max-width: 992px) {
    .related-art-grid {
        column-count: 2;
    }
}
@media (max-width: 767px) {
    .art-feature-image {
        max-width: 90vw;
    }
    .art-title {
        font-size: 1.8rem;
    }
    .related-art-grid {
        column-count: 2;
    }

    .related-art-item {
        margin-bottom: 10px; /* スマホでは間隔を狭く */
    }
}

.dark-mode .art-title,
.dark-mode .art-excerpt,
.dark-mode .related-art-title {
    color: #b0b0b0;
}
.dark-mode .art-meta {
    color: #8a8a8a;
}
.dark-mode .related-art-section {
    border-top-color: rgba(255, 255, 255, 0.1);
}
.dark-mode .related-art-item::before {
    background: rgba(0, 0, 0, 0.4);
}


/* ==========================================================================
   New Post Sparkle Effect
   Note: キラキラエフェクトのスタイルはscreen.cssに統一されています
   ========================================================================== */

</style>


<style>
    // フッターを非表示にする
    .site-footer {
        display: none;
    }
</style>