<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/post.css"}}" />

    {{! --- Google Fonts (フォント用) --- }}

    {{! --- Font Awesome (アイコン用) ---}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" xintegrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    {{! --- Ghost必須ヘルパー(Head) --- }}
    {{ghost_head}}
</head>
<body class="{{body_class}}" >

    <header class="site-header">
        <div class="header-container">
            <div class="header-actions">
                <button class="action-button circle-button search-button" data-ghost-search aria-label="検索">
                    <i class="fas fa-search"></i>
                </button>
                <button class="action-button circle-button theme-toggle-button" aria-label="テーマ切り替え">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="action-button circle-button menu-toggle-button" aria-label="メニューを開く">
                    <span class="menu-text">MENU</span>
                    <span class="close-icon">×</span>
                </button>
            </div>
        </div>
    </header>

    <!-- フルスクリーンナビゲーションコンテナを修正 -->
    <div class="fullscreen-nav-container">
        <nav class="fullscreen-nav">
            <div class="nav-column">
                {{!-- URLは実際のリンク先に変更してください --}}
                <a href="/" class="nav-link">
                    <h2>Home</h2>
                    <p>静かな庭へようこそ</p>
                </a>

                <a href="/tag/rambles/" class="nav-link">
                    <h2>Journal</h2>
                    <p>日々の記録</p>
                </a>
                
                <a href="/writings/" class="nav-link">
                    <h2>Writings</h2>
                    <p>紡いだ言葉</p>
                </a>
                
                <a href="/gallery/" class="nav-link">
                    <h2>Gallery</h2>
                    <p>ピクセル画廊</p>
                </a>
            </div>
            
            <div class="nav-column">
                {{!-- URLは実際のリンク先に変更してください --}}
                <a href="/tag/review/" class="nav-link">
                    <h2>Perspective</h2>
                    <p>社会へのまなざし</p>
                </a>
                
                <a href="/archives/" class="nav-link">
                    <h2>Archives</h2>
                    <p>すべての記事</p>
                </a>

                <a href="/products/" class="nav-link">
                    <h2>Products</h2>
                    <p>形あるもの</p>
                </a>
                
                <a href="/about/" class="nav-link">
                    <h2>About</h2>
                    <p>この場所について</p>
                </a>
            </div>
            
            <div class="nav-column nav-column-right">
                <div class="nav-footer">

                    {{! --- キャラクターイラスト --- }}
                    <div class="character-illustration">
                        <img src="{{asset "images/top-image.webp"}}" alt="Character illustration">
                    </div>

                    <!-- 1. サイトのコンセプト -->
                    <p class="site-concept">言葉と光が交差する、静かな庭。</p>
                    <p class="site-description">HANAGORIは、日々の思索と創作を通じて、心の静けさと美しさを追求する場所です。</p>

                    <!-- 2. 補足情報へのリンク -->
                    <div class="footer-links">
                        <a href="/contact/">お問い合わせ</a>
                        <a href="/privacy/">プライバシーポリシー</a>
                    </div>
                    
                    <!-- 3. ソーシャルリンク -->
                    <div class="social-links">
                        <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        {{!-- 他のSNSがあれば追加 --}}
                    </div>

                    <!-- 4. コピーライト -->
                    <p class="copyright">&copy; 2025 HANAGORI.</p>                   
                </div>
            </div>
        </nav>
    </div>

    {{! --- ここに各ページの内容が挿入される --- }}
    {{{body}}}


    {{! --- フッター --- }}
    <footer class="site-footer">
        <div class="footer-container">
            {{! --- サイト情報 & 今日のひとこと --- }}
            <div class="footer-column about-column">
                
                {{! --- 今日のひとことセクション --- }}
                <div class="word-of-the-day-section">
                    <h4 class="word-of-the-day-title">
                        <span class="title-icon">💭</span>
                        今日のひとこと
                    </h4>
                    <div class="word-of-the-day">
                        <div class="word-icon">
                            {{! ここにキャラクターアイコンを配置 }}
                            <img src="{{asset "images/アイコン.webp"}}" alt="キャラクターアイコン">
                        </div>
                        <div class="word-bubble">
                            {{#get "posts" filter="tag:word-of-the-day" limit="1"}}
                                {{#foreach posts}}
                                    <p>{{excerpt}}</p>
                                {{else}}
                                    <p>今日のひとことは、お休みです。</p>
                                {{/foreach}}
                            {{/get}}
                        </div>
                    </div>
                </div>
            </div>

            {{! --- サイト内リンク --- }}
            <div class="footer-column links-column">
                <h4 class="footer-title">リンク</h4>
                <ul>
                    <li><a href="{{@site.url}}">ホーム</a></li>
                    <li><a href="/essays/">エッセイ</a></li>
                    <li><a href="/novels/">小説</a></li>
                    <li><a href="/reviews/">批評・レビュー</a></li>
                    <li><a href="/gallery/">ピクセルアート</a></li>
                    <li><a href="#/portal/support">サポートについて</a></li>
                </ul>
            </div>

            {{! --- フォロー & お問い合わせ --- }}
            <div class="footer-column follow-column">
                <h4 class="footer-title">フォロー</h4>
                <div class="social-links">
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    <a href="#" aria-label="Discord"><i class="fab fa-discord"></i></a>
                </div>
                <h4 class="footer-title">お問い合わせ</h4>
                <a href="/contact/" class="btn-contact">お問い合わせフォーム</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; {{date format="YYYY"}} {{@site.title}} All Rights Reserved.</p>
            <nav class="footer-nav">
                <a href="/privacy-policy/">プライバシーポリシー</a>
                <a href="/terms/">利用規約</a>
                <a href="/sitemap/">サイトマップ</a>
            </nav>
        </div>
    </footer>

    {{! (既存のスクリプト) }}
    
    <script src="{{asset "js/main.js"}}"></script>

    {{! --- Ghost必須ヘルパー(Foot) --- }}
    {{ghost_foot}}
</body>
</html>
