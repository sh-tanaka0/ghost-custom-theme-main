{{!< default}}

<main class="site-main">
    {{#post}}
        {{! post.cssのクラス構造に合わせて変更 }}
        <article class="post-full {{post_class}}">

            {{#if @page.show_title_and_feature_image}}
            <header class="post-full-header">
                {{#if feature_image}}
                    <div class="post-feature-image-wrapper">
                        <img class="post-full-image" src="{{feature_image}}" alt="{{title}}" />
                    </div>
                {{/if}}
            </header>
            {{/if}}

            <div class="main-content-wrapper">
                <div class="post-header-and-content">

                    {{#if @page.show_title_and_feature_image}}
                    <div class="post-header-content">
                        <h1 class="post-full-title">{{title}}</h1>
                    </div>
                    {{/if}}

                    {{! 本文エリア }}
                    <section class="post-full-content gh-content">
                        {{{content}}}
                    </section>

                </div>
            </div>

        </article>
    {{/post}}
</main>

