{{!< default}}

{{!-- このファイルはHTMLとCSS、JSを1つにまとめていますが、実際には .hbs と .css、.js ファイルに分けてください --}}
<style>
    /* ==========================================================================
       Variables (実際のサイトの変数に合わせてください)
       ========================================================================== */
    :root {
        --color-text: #4a4a4a;
        --color-text-secondary: #7d7d7d;
        --color-bg: #fff;
        --color-border: rgba(0, 0, 0, 0.1);
    }
    .dark-mode {
        --color-text: #b0b0b0;
        --color-text-secondary: #8a8a8a;
        --color-bg: #1a1a1a;
        --color-border: rgba(255, 255, 255, 0.1);
    }
    body {
        background-color: var(--color-bg);
        color: var(--color-text);
    }
    @import url('https://fonts.googleapis.com/css2?family=DotGothic16&display=swap');

    /* ==================================
       Gallery Page Header
       ================================== */
    .page-header {
        padding: 100px 40px 60px;
        text-align: center;
    }
    .page-header-inner {
        max-width: 800px;
        margin: 0 auto;
    }
    .page-title {
        font-family: 'DotGothic16', monospace;
        font-size: 2.5rem;
        font-weight: 400;
        color: var(--color-text);
        letter-spacing: 0.1em;
        margin: 0 0 10px;
    }
    .page-subtitle {
        font-size: 1rem;
        color: var(--color-text-secondary);
        letter-spacing: 0.2em;
        margin: 0 0 24px;
    }
    .page-description {
        font-size: 1rem;
        line-height: 1.8;
        color: var(--color-text-secondary);
        max-width: 600px;
        margin: 0 auto;
    }

    /* ==================================
       Gallery Grid (ドットアート投稿ページのスタイルをベース)
       ================================== */
    .gallery-section {
        padding: 0 20px 80px;
        max-width: 1400px;
        margin: 0 auto;
    }
    .gallery-grid {
        column-count: 4;
        column-gap: 20px;
    }
    .gallery-item {
        position: relative;
        display: inline-block;
        width: 100%;
        margin-bottom: 20px;
        break-inside: avoid;
        overflow: hidden;
        border-radius: 4px;
    }
    .gallery-item img {
        display: block;
        width: 100%;
        height: auto;
        transition: transform 0.4s ease;
    }
    .gallery-item:hover img {
        transform: scale(1.05);
    }
    .gallery-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.5);
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
    }
    .gallery-item:hover::before {
        opacity: 1;
    }
    .gallery-item-info {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 100%;
        padding: 20px 15px 15px;
        color: #fff;
        z-index: 2;
        text-align: right;
        background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .gallery-item:hover .gallery-item-info {
        opacity: 1;
        transform: translateY(0);
    }
    .gallery-item-title {
        font-family: 'DotGothic16', sans-serif;
        font-size: 1rem;
        font-weight: 400;
        margin: 0 0 5px;
        color: #fff;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
    }
    .gallery-item-date {
        font-family: sans-serif;
        font-size: 0.75rem;
        color: #fff;
        opacity: 0.8;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
    }
    .dark-mode .gallery-item::before {
        background: rgba(0, 0, 0, 0.4);
    }

    /* --- Loading Indicator --- */
    .loading-indicator {
        text-align: center;
        padding: 40px;
        display: none; /* 初期状態では非表示 */
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .loading-indicator.is-visible {
        display: block;
        opacity: 1;
    }
    .loader {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #888;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }
    .dark-mode .loader {
        border-color: #333;
        border-top-color: #888;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* --- レスポンシブ --- */
    @media (max-width: 1200px) { .gallery-grid { column-count: 3; } }
    @media (max-width: 992px) { .gallery-grid { column-count: 2; } }
    @media (max-width: 767px) { .gallery-grid { column-count: 1; } }

</style>

<div class="gallery-template">

    <header class="page-header">
        <div class="page-header-inner">
            <h1 class="page-title">Gallery</h1>
            <p class="page-subtitle">光の画廊</p>
            <p class="page-description">
                ピクセルが織りなす、ささやかな光の記録たち。<br>
                ここでは、これまでに描かれたすべてのアートワークを収めています。
            </p>
        </div>
    </header>

    <section class="gallery-section">
        <div id="gallery-grid" class="gallery-grid">
            {{!-- 最初の投稿はサーバーサイドでレンダリング --}}
            {{#get "posts" filter="tag:dot-art" limit=12 as |gallery_posts|}}
                {{#foreach gallery_posts}}
                    <a href="{{url}}" class="gallery-item">
                        {{#if feature_image}}
                            <img src="{{feature_image}}" alt="{{title}}" loading="lazy" />
                        {{/if}}
                        <div class="gallery-item-info">
                            <h3 class="gallery-item-title">{{title}}</h3>
                            <time class="gallery-item-date">{{date format="YYYY.MM.DD"}}</time>
                        </div>
                    </a>
                {{/foreach}}
            {{/get}}
        </div>

        {{!-- ローディングインジケーター --}}
        <div id="loading-indicator" class="loading-indicator">
            <div class="loader"></div>
        </div>
    </section>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // 無限スクロールの設定
    const galleryGrid = document.getElementById('gallery-grid');
    const loadingIndicator = document.getElementById('loading-indicator');
    
    // Ghost APIの設定 (これらの変数はGhost環境で利用可能である必要があります)
    const apiKey = window.GHOST_API_KEY || 'YOUR_CONTENT_API_KEY'; // Ghostが提供するAPIキー, なければ手動で設定
    const apiURL = window.location.origin;

    let currentPage = 2; // 次に読み込むページ
    let isLoading = false;
    let allPostsLoaded = false;

    // 投稿アイテムを生成する関数
    const createPostItem = (post) => {
        const item = document.createElement('a');
        item.href = post.url;
        item.className = 'gallery-item';

        if (post.feature_image) {
            const img = document.createElement('img');
            img.src = post.feature_image;
            img.alt = post.title;
            img.loading = 'lazy';
            item.appendChild(img);
        }

        const info = document.createElement('div');
        info.className = 'gallery-item-info';

        const title = document.createElement('h3');
        title.className = 'gallery-item-title';
        title.textContent = post.title;
        info.appendChild(title);

        const date = document.createElement('time');
        date.className = 'gallery-item-date';
        // 日付のフォーマット
        const publishedDate = new Date(post.published_at);
        date.textContent = `${publishedDate.getFullYear()}.${String(publishedDate.getMonth() + 1).padStart(2, '0')}.${String(publishedDate.getDate()).padStart(2, '0')}`;
        info.appendChild(date);

        item.appendChild(info);
        return item;
    };

    // 次のページの投稿を読み込む関数
    const loadMorePosts = async () => {
        if (isLoading || allPostsLoaded) return;

        isLoading = true;
        loadingIndicator.classList.add('is-visible');

        try {
            const url = `${apiURL}/ghost/api/content/posts/?key=${apiKey}&filter=tag:dot-art&limit=12&page=${currentPage}&fields=title,url,feature_image,published_at`;
            const response = await fetch(url);
            
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            
            const data = await response.json();

            if (data.posts.length > 0) {
                data.posts.forEach(post => {
                    const postItem = createPostItem(post);
                    galleryGrid.appendChild(postItem);
                });
                currentPage++;
            } else {
                allPostsLoaded = true; // これ以上投稿がない
            }

        } catch (error) {
            console.error('Error fetching more posts:', error);
            allPostsLoaded = true; // エラーが発生した場合も読み込みを停止
        } finally {
            isLoading = false;
            loadingIndicator.classList.remove('is-visible');
        }
    };

    // スクロールイベントの監視
    window.addEventListener('scroll', () => {
        // ページの最下部近くまでスクロールされたかチェック
        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 500) {
            loadMorePosts();
        }
    });
});
</script>
