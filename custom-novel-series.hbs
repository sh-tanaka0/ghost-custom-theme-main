{{!< default}}

<main class="novel-main">
    {{#post}}
        <article class="novel-article {{post_class}}">
            
            {{!-- 読書進捗バー --}}
            <div class="reading-progress-bar"></div>
            
            {{!-- ヘッダー部（シンプルに） --}}
            <header class="novel-header">
                <div class="novel-series-info">
                    {{#primary_tag}}
                        <a href="{{url}}" class="series-badge">
                            <span class="series-label">シリーズ</span>
                            <span class="series-name">{{name}}</span>
                        </a>
                    {{/primary_tag}}
                </div>
                
                <h1 class="novel-title">{{title}}</h1>
                
                <div class="novel-meta">
                    <span class="novel-date">
                        <time datetime="{{date format="YYYY-MM-DD"}}">
                            {{date format="YYYY.MM.DD"}}
                        </time>
                    </span>
                    <span class="divider">・</span>
                    <span class="word-count" data-content="{{{content}}}"></span>
                    <span class="divider">・</span>
                    <span class="reading-time">{{reading_time minute="1分" minutes="%分"}}</span>
                </div>
            </header>

            {{!-- 本文エリア --}}
            <div class="novel-content-wrapper">
                <section class="novel-content gh-content">
                    {{{content}}}
                </section>
            </div>

            {{!-- 読みやすさ設定パネル（小説向けに拡張） --}}
            <div class="novel-settings-panel">
                <button class="settings-toggle" aria-label="読書設定">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                    </svg>
                </button>
                <div class="settings-content">
                    <h4 class="settings-title">読書設定</h4>
                    
                    <div class="setting-group">
                        <label>フォント</label>
                        <div class="font-selector">
                            <button data-font="noto-serif" class="active">明朝</button>
                            <button data-font="noto-sans">ゴシック</button>
                        </div>
                    </div>
                    
                    <div class="setting-group">
                        <label>文字サイズ</label>
                        <div class="size-selector">
                            <button data-size="small">小</button>
                            <button data-size="medium" class="active">中</button>
                            <button data-size="large">大</button>
                        </div>
                    </div>
                    
                    <div class="setting-group">
                        <label>行間</label>
                        <div class="line-height-selector">
                            <button data-line-height="narrow">狭</button>
                            <button data-line-height="normal" class="active">標準</button>
                            <button data-line-height="wide">広</button>
                        </div>
                    </div>
                    
                    <div class="setting-group">
                        <label>背景色</label>
                        <div class="theme-selector">
                            <button data-theme="default" class="active" aria-label="デフォルト">
                                <span class="theme-preview default"></span>
                            </button>
                            <button data-theme="sepia" aria-label="セピア">
                                <span class="theme-preview sepia"></span>
                            </button>
                            <button data-theme="night" aria-label="夜間">
                                <span class="theme-preview night"></span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="setting-group">
                        <button class="bookmark-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                            </svg>
                            <span>しおりを挟む</span>
                        </button>
                    </div>
                </div>
            </div>

            {{!-- エピソードナビゲーション --}}
            <nav class="episode-navigation">
                {{!-- 前の話 --}}
                <div class="episode-nav-item prev">
                    <span class="nav-label">前の話</span>
                    {{#prev_post in="primary_tag"}}
                        <a href="{{url}}" class="nav-link">
                            <svg class="nav-arrow left" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                            </svg>
                            <span class="nav-title">{{title}}</span>
                        </a>
                        {{!-- 前の話のティーザー --}}
                        <div class="episode-teaser prev-teaser">
                            <p class="teaser-text">{{excerpt words="30"}}...</p>
                            <span class="continue-reading">← 前の話を読む</span>
                        </div>
                    {{else}}
                        <div class="no-episode">
                            <svg class="no-episode-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                            </svg>
                            <span class="no-episode-text">第1話です</span>
                        </div>
                    {{/prev_post}}
                </div>
                
                {{!-- シリーズ一覧 --}}
                <div class="episode-nav-item series">
                    {{#primary_tag}}
                        <a href="{{url}}" class="series-link">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                            </svg>
                            <span>シリーズ一覧</span>
                        </a>
                    {{/primary_tag}}
                </div>
                
                {{!-- 次の話 --}}
                <div class="episode-nav-item next">
                    <span class="nav-label">次の話</span>
                    {{#next_post in="primary_tag"}}
                        <a href="{{url}}" class="nav-link">
                            <span class="nav-title">{{title}}</span>
                            <svg class="nav-arrow right" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                            </svg>
                        </a>
                        {{!-- 次の話のティーザー --}}
                        <div class="episode-teaser next-teaser">
                            <p class="teaser-text">{{excerpt words="30"}}...</p>
                            <span class="continue-reading">続きを読む →</span>
                        </div>
                    {{else}}
                        <div class="no-episode">
                            <svg class="no-episode-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="no-episode-text">最新話です</span>
                        </div>
                    {{/next_post}}
                </div>
            </nav>

            {{!-- サポートセクション（シンプルに） --}}
            <section class="novel-support">
                <p class="support-text">この作品を応援する</p>
                <a href="/#/portal/support" class="support-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                </a>
            </section>

            {{!-- コメント欄 --}}
            {{#if comments}}
                <section class="novel-comments">
                    <h2 class="comments-title">感想・コメント</h2>
                    {{comments title="" count=false}}
                </section>
            {{/if}}

        </article>
    {{/post}}
</main>

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@400;500&family=DotGothic16&display=swap');

/* ==========================================================================
   Base & Reset
   ========================================================================== */
:root {
    /* デフォルトテーマ（青磁色ベース） */
    --novel-bg: #f0f7f4;
    --novel-text: #2d3748;
    --novel-text-secondary: #718096;
    --novel-border: rgba(0, 0, 0, 0.08);
    --novel-accent: #4a5568;
    --novel-hover: #2d3748;
    --novel-shadow: rgba(0, 0, 0, 0.05);
}

/* セピアテーマ */
body[data-theme="sepia"] {
    --novel-bg: #f7f3ed;
    --novel-text: #3e2723;
    --novel-text-secondary: #6d4c41;
    --novel-border: rgba(62, 39, 35, 0.1);
    --novel-accent: #5d4037;
    --novel-hover: #3e2723;
}

/* ナイトテーマ */
body[data-theme="night"] {
    --novel-bg: #1a202c;
    --novel-text: #e2e8f0;
    --novel-text-secondary: #a0aec0;
    --novel-border: rgba(255, 255, 255, 0.1);
    --novel-accent: #cbd5e0;
    --novel-hover: #e2e8f0;
}

/* ==========================================================================
   Layout
   ========================================================================== */
.novel-main {
    min-height: 100vh;
    background: var(--novel-bg);
    transition: background-color 0.3s ease;
    padding: 0 20px;
}

.novel-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 60px 0 100px;
}

/* ==========================================================================
   読書進捗バー
   ========================================================================== */
.reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg, #a8dadc 0%, #457b9d 100%);
    z-index: 1000;
    transition: width 0.2s ease;
}

/* ==========================================================================
   Header
   ========================================================================== */
.novel-header {
    text-align: center;
    margin-bottom: 80px;
}

.novel-series-info {
    margin-bottom: 24px;
}

.series-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: transparent;
    border: 1px solid var(--novel-border);
    border-radius: 20px;
    text-decoration: none;
    color: var(--novel-text-secondary);
    font-size: 0.875rem;
    transition: all 0.3s ease;
}

.series-badge:hover {
    border-color: var(--novel-accent);
    color: var(--novel-accent);
}

.series-label {
    opacity: 0.7;
    font-size: 0.75rem;
}

.novel-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    color: var(--novel-text);
    line-height: 1.5;
    margin: 0 0 24px;
    letter-spacing: 0.05em;
}

.novel-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    color: var(--novel-text-secondary);
    font-size: 0.875rem;
}

.divider {
    opacity: 0.3;
}

/* ==========================================================================
   Content
   ========================================================================== */
.novel-content-wrapper {
    position: relative;
}

.novel-content {
    font-family: 'Noto Serif JP', serif;
    font-size: 16px;
    line-height: 2.2;
    letter-spacing: 0.05em;
    color: var(--novel-text);
    margin-bottom: 100px;
}

/* 段落の調整 */
.novel-content p {
    margin: 0 0 2em;
    text-indent: 1em;
}

.novel-content p:first-of-type {
    text-indent: 0;
}

/* 章タイトル */
.novel-content h2 {
    font-family: 'DotGothic16', monospace;
    font-size: 1.25rem;
    text-align: center;
    margin: 80px 0 60px;
    padding: 20px 0;
    border-top: 1px solid var(--novel-border);
    border-bottom: 1px solid var(--novel-border);
    letter-spacing: 0.2em;
    color: var(--novel-text);
}

.novel-content h3 {
    font-size: 1.1rem;
    margin: 60px 0 40px;
    text-align: center;
    color: var(--novel-text-secondary);
}

/* セリフ・会話文（カギ括弧で始まる段落） */
.novel-content p:has-text('「') {
    text-indent: 0;
    margin: 1.5em 0;
}

/* ==========================================================================
   Settings Panel
   ========================================================================== */
.novel-settings-panel {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 100;
    opacity: 0.9;
    transition: opacity 0.3s ease;
}

.novel-settings-panel:hover {
    opacity: 1;
}

.settings-toggle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--novel-bg);
    border: 1px solid var(--novel-border);
    box-shadow: 0 4px 12px var(--novel-shadow);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.settings-toggle svg {
    width: 24px;
    height: 24px;
    color: var(--novel-text-secondary);
}

.settings-toggle:hover {
    box-shadow: 0 6px 20px var(--novel-shadow);
    transform: translateY(-2px);
}

.settings-content {
    display: none;
    position: absolute;
    bottom: 60px;
    right: 0;
    background: var(--novel-bg);
    border-radius: 12px;
    box-shadow: 0 10px 40px var(--novel-shadow);
    padding: 24px;
    min-width: 280px;
    border: 1px solid var(--novel-border);
}

.settings-content.active {
    display: block;
}

.settings-title {
    font-family: 'DotGothic16', monospace;
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin: 0 0 20px;
    color: var(--novel-text);
}

.setting-group {
    margin-bottom: 20px;
}

.setting-group label {
    display: block;
    margin-bottom: 10px;
    font-size: 0.875rem;
    color: var(--novel-text-secondary);
}

.font-selector,
.size-selector,
.line-height-selector {
    display: flex;
    gap: 4px;
}

.font-selector button,
.size-selector button,
.line-height-selector button {
    flex: 1;
    padding: 8px;
    border: 1px solid var(--novel-border);
    background: transparent;
    color: var(--novel-text-secondary);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.2s;
}

.font-selector button.active,
.size-selector button.active,
.line-height-selector button.active {
    background: var(--novel-accent);
    color: var(--novel-bg);
    border-color: var(--novel-accent);
}

/* テーマセレクター */
.theme-selector {
    display: flex;
    gap: 8px;
}

.theme-selector button {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
}

.theme-selector button.active {
    border-color: var(--novel-accent);
}

.theme-preview {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 6px;
}

.theme-preview.default { background: #f0f7f4; }
.theme-preview.sepia { background: #f7f3ed; }
.theme-preview.night { background: #1a202c; }

/* しおりボタン */
.bookmark-btn {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--novel-border);
    background: transparent;
    color: var(--novel-text-secondary);
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s;
}

.bookmark-btn svg {
    width: 18px;
    height: 18px;
}

.bookmark-btn:hover {
    background: var(--novel-accent);
    color: var(--novel-bg);
    border-color: var(--novel-accent);
}

.bookmark-btn.bookmarked {
    background: var(--novel-accent);
    color: var(--novel-bg);
}

/* ==========================================================================
   Episode Navigation
   ========================================================================== */
.episode-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    margin: 80px 0;
    padding: 40px 0;
    border-top: 1px solid var(--novel-border);
    border-bottom: 1px solid var(--novel-border);
}

.episode-nav-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.nav-label {
    font-size: 0.75rem;
    color: var(--novel-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--novel-text);
    transition: all 0.3s ease;
}

.nav-link:hover {
    color: var(--novel-accent);
}

.nav-arrow {
    width: 20px;
    height: 20px;
    opacity: 0.5;
}

.nav-title {
    font-size: 0.95rem;
    line-height: 1.4;
}

.episode-nav-item.prev {
    text-align: left;
}

.episode-nav-item.next {
    text-align: right;
}

.episode-nav-item.next .nav-link {
    justify-content: flex-end;
}

.episode-nav-item.series {
    display: flex;
    align-items: center;
    justify-content: center;
}

.series-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border: 1px solid var(--novel-border);
    border-radius: 20px;
    text-decoration: none;
    color: var(--novel-text-secondary);
    font-size: 0.875rem;
    transition: all 0.3s ease;
}

.series-link svg {
    width: 18px;
    height: 18px;
}

.series-link:hover {
    border-color: var(--novel-accent);
    color: var(--novel-accent);
}

/* 次話ティーザー */
.next-episode-teaser {
    margin-top: 16px;
    padding: 16px;
    background: linear-gradient(to bottom, var(--novel-bg), transparent);
    border-left: 2px solid var(--novel-border);
}

.teaser-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--novel-text-secondary);
    margin: 0 0 8px;
    opacity: 0.8;
}

.continue-reading {
    font-size: 0.75rem;
    color: var(--novel-accent);
    font-weight: 500;
}

/* ==========================================================================
   Support Section
   ========================================================================== */
.novel-support {
    text-align: center;
    padding: 60px 0;
    border-top: 1px solid var(--novel-border);
}

.support-text {
    font-family: 'DotGothic16', monospace;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--novel-text-secondary);
    margin-bottom: 20px;
}

.support-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 1px solid var(--novel-border);
    color: var(--novel-text-secondary);
    transition: all 0.3s ease;
}

.support-btn svg {
    width: 24px;
    height: 24px;
}

.support-btn:hover {
    transform: scale(1.1);
    border-color: var(--novel-accent);
    color: var(--novel-accent);
}

/* ==========================================================================
   Comments
   ========================================================================== */
.novel-comments {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--novel-border);
}

.comments-title {
    font-family: 'DotGothic16', monospace;
    font-size: 1.25rem;
    letter-spacing: 0.15em;
    text-align: center;
    margin-bottom: 40px;
    color: var(--novel-text);
}

/* ==========================================================================
   フォント切り替え
   ========================================================================== */
body[data-font="noto-sans"] .novel-content {
    font-family: 'Noto Sans JP', sans-serif;
}

body[data-font="noto-serif"] .novel-content {
    font-family: 'Noto Serif JP', serif;
}

/* ==========================================================================
   文字サイズ切り替え
   ========================================================================== */
body[data-size="small"] .novel-content {
    font-size: 14px;
}

body[data-size="medium"] .novel-content {
    font-size: 16px;
}

body[data-size="large"] .novel-content {
    font-size: 18px;
}

/* ==========================================================================
   行間切り替え
   ========================================================================== */
body[data-line-height="narrow"] .novel-content {
    line-height: 1.8;
}

body[data-line-height="normal"] .novel-content {
    line-height: 2.2;
}

body[data-line-height="wide"] .novel-content {
    line-height: 2.6;
}

/* ==========================================================================
   Responsive
   ========================================================================== */
@media (max-width: 768px) {
    .novel-article {
        padding: 40px 0 80px;
    }
    
    .novel-header {
        margin-bottom: 60px;
    }
    
    .novel-title {
        font-size: 1.5rem;
    }
    
    .novel-content {
        font-size: 15px;
        margin-bottom: 60px;
    }
    
    .novel-content h2 {
        margin: 60px 0 40px;
    }
    
    .episode-navigation {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .episode-nav-item.series {
        order: -1;
    }
    
    .novel-settings-panel {
        bottom: 20px;
        right: 20px;
    }
    
    .settings-toggle {
        width: 44px;
        height: 44px;
    }
    
    body[data-size="small"] .novel-content {
        font-size: 13px;
    }
    
    body[data-size="medium"] .novel-content {
        font-size: 15px;
    }
    
    body[data-size="large"] .novel-content {
        font-size: 17px;
    }
}

/* ==========================================================================
   Episode Navigation - 修正・追加部分
   ========================================================================== */

/* 前後の話がない場合の表示 */
.no-episode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: linear-gradient(135deg, transparent, var(--novel-bg));
    border-radius: 8px;
    border: 1px dashed var(--novel-border);
}

.no-episode-icon {
    width: 32px;
    height: 32px;
    color: var(--novel-text-secondary);
    opacity: 0.3;
}

.no-episode-text {
    font-size: 0.875rem;
    color: var(--novel-text-secondary);
    font-style: italic;
    letter-spacing: 0.05em;
}

/* エピソードティーザー共通スタイル（前話・次話両方） */
.episode-teaser {
    margin-top: 16px;
    padding: 16px;
    background: linear-gradient(to bottom, var(--novel-bg), transparent);
    border-radius: 8px;
    position: relative;
}

/* 前話ティーザー専用 */
.prev-teaser {
    border-right: 2px solid var(--novel-border);
    text-align: left;
}

/* 次話ティーザー専用 */
.next-teaser {
    border-left: 2px solid var(--novel-border);
    text-align: right;
}

.teaser-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--novel-text-secondary);
    margin: 0 0 8px;
    opacity: 0.8;
}

.continue-reading {
    font-size: 0.75rem;
    color: var(--novel-accent);
    font-weight: 500;
    display: inline-block;
    transition: all 0.3s ease;
}

.continue-reading:hover {
    opacity: 0.7;
}

/* レスポンシブ調整 */
@media (max-width: 768px) {
    .no-episode {
        padding: 16px;
    }
    
    .episode-teaser {
        margin-top: 12px;
        padding: 12px;
    }
    
    .prev-teaser,
    .next-teaser {
        text-align: left;
    }
}

/* ダークモード対応 */
body[data-theme="night"] .no-episode {
    background: linear-gradient(135deg, transparent, rgba(255, 255, 255, 0.02));
    border-color: rgba(255, 255, 255, 0.1);
}

body[data-theme="night"] .episode-teaser {
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.02), transparent);
}

body[data-theme="sepia"] .no-episode {
    background: linear-gradient(135deg, transparent, rgba(62, 39, 35, 0.02));
}

body[data-theme="sepia"] .episode-teaser {
    background: linear-gradient(to bottom, rgba(62, 39, 35, 0.02), transparent);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ==========================================================================
    // 読書進捗バー
    // ==========================================================================
    const progressBar = document.querySelector('.reading-progress-bar');
    
    function updateProgressBar() {
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight - windowHeight;
        const scrolled = window.scrollY;
        const progress = (scrolled / documentHeight) * 100;
        progressBar.style.width = progress + '%';
    }
    
    window.addEventListener('scroll', updateProgressBar);
    
    // ==========================================================================
    // 文字数カウント
    // ==========================================================================
    const wordCountEl = document.querySelector('.word-count');
    if (wordCountEl) {
        const content = wordCountEl.dataset.content;
        const text = content.replace(/<[^>]*>/g, '').replace(/\s+/g, '');
        const count = text.length;
        wordCountEl.textContent = `${count.toLocaleString()}文字`;
    }
    
    // ==========================================================================
    // 設定パネル
    // ==========================================================================
    const settingsToggle = document.querySelector('.settings-toggle');
    const settingsContent = document.querySelector('.settings-content');
    
    settingsToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        settingsContent?.classList.toggle('active');
    });
    
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.novel-settings-panel')) {
            settingsContent?.classList.remove('active');
        }
    });
    
    // ==========================================================================
    // フォント切り替え
    // ==========================================================================
    document.querySelectorAll('.font-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.font-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-font', btn.dataset.font);
            localStorage.setItem('novel-font', btn.dataset.font);
        });
    });
    
    // ==========================================================================
    // 文字サイズ切り替え
    // ==========================================================================
    document.querySelectorAll('.size-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.size-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-size', btn.dataset.size);
            localStorage.setItem('novel-size', btn.dataset.size);
        });
    });
    
    // ==========================================================================
    // 行間切り替え
    // ==========================================================================
    document.querySelectorAll('.line-height-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.line-height-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-line-height', btn.dataset.lineHeight);
            localStorage.setItem('novel-line-height', btn.dataset.lineHeight);
        });
    });
    
    // ==========================================================================
    // テーマ切り替え
    // ==========================================================================
    document.querySelectorAll('.theme-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.theme-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-theme', btn.dataset.theme);
            localStorage.setItem('novel-theme', btn.dataset.theme);
        });
    });
    
    // ==========================================================================
    // しおり機能
    // ==========================================================================
    const bookmarkBtn = document.querySelector('.bookmark-btn');
    const articlePath = window.location.pathname;
    
    bookmarkBtn?.addEventListener('click', () => {
        const scrollPosition = window.scrollY;
        const bookmark = {
            path: articlePath,
            position: scrollPosition,
            title: document.querySelector('.novel-title').textContent,
            date: new Date().toISOString()
        };
        
        localStorage.setItem('novel-bookmark', JSON.stringify(bookmark));
        bookmarkBtn.classList.add('bookmarked');
        
        // フィードバック
        const originalText = bookmarkBtn.querySelector('span').textContent;
        bookmarkBtn.querySelector('span').textContent = 'しおりを挟みました';
        setTimeout(() => {
            bookmarkBtn.querySelector('span').textContent = originalText;
        }, 2000);
    });
    
    // しおりの確認と復元
    const savedBookmark = localStorage.getItem('novel-bookmark');
    if (savedBookmark) {
        const bookmark = JSON.parse(savedBookmark);
        if (bookmark.path === articlePath) {
            // 同じ記事の場合、しおり位置を復元するか確認
            const shouldRestore = confirm('前回の読書位置から再開しますか？');
            if (shouldRestore) {
                window.scrollTo({
                    top: bookmark.position,
                    behavior: 'smooth'
                });
            }
            bookmarkBtn?.classList.add('bookmarked');
        }
    }
    
    // ==========================================================================
    // 保存した設定を読み込み
    // ==========================================================================
    const savedFont = localStorage.getItem('novel-font') || 'noto-serif';
    const savedSize = localStorage.getItem('novel-size') || 'medium';
    const savedLineHeight = localStorage.getItem('novel-line-height') || 'normal';
    const savedTheme = localStorage.getItem('novel-theme') || 'default';
    
    // フォント
    document.body.setAttribute('data-font', savedFont);
    const fontBtn = document.querySelector(`.font-selector button[data-font="${savedFont}"]`);
    if (fontBtn) {
        document.querySelectorAll('.font-selector button').forEach(b => b.classList.remove('active'));
        fontBtn.classList.add('active');
    }
    
    // サイズ
    document.body.setAttribute('data-size', savedSize);
    const sizeBtn = document.querySelector(`.size-selector button[data-size="${savedSize}"]`);
    if (sizeBtn) {
        document.querySelectorAll('.size-selector button').forEach(b => b.classList.remove('active'));
        sizeBtn.classList.add('active');
    }
    
    // 行間
    document.body.setAttribute('data-line-height', savedLineHeight);
    const lineHeightBtn = document.querySelector(`.line-height-selector button[data-line-height="${savedLineHeight}"]`);
    if (lineHeightBtn) {
        document.querySelectorAll('.line-height-selector button').forEach(b => b.classList.remove('active'));
        lineHeightBtn.classList.add('active');
    }
    
    // テーマ
    document.body.setAttribute('data-theme', savedTheme);
    const themeBtn = document.querySelector(`.theme-selector button[data-theme="${savedTheme}"]`);
    if (themeBtn) {
        document.querySelectorAll('.theme-selector button').forEach(b => b.classList.remove('active'));
        themeBtn.classList.add('active');
    }
    
    // ==========================================================================
    // 自動セーブ（読書位置）
    // ==========================================================================
    let saveTimer;
    window.addEventListener('scroll', () => {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
            const currentPosition = window.scrollY;
            const readingProgress = {
                path: articlePath,
                position: currentPosition,
                timestamp: new Date().toISOString()
            };
            localStorage.setItem('novel-reading-progress', JSON.stringify(readingProgress));
        }, 1000);
    });
});
</script>