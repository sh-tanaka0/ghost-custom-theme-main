{{!< default}}

<main class="site-main">
    {{#post}}
        <article class="post-full {{post_class}}">
            {{!-- ヘッダー部 --}}
            <header class="post-full-header">
                {{#if feature_image}}
                    <div class="post-feature-image-wrapper">
                        <img class="post-full-image" src="{{feature_image}}" alt="{{title}}" />
                    </div>
                {{/if}}
            </header>

            <div class="main-content-wrapper">

                <div class="post-header-and-content">
                    <div class="post-header-content">
                        <h1 class="post-full-title">{{title}}</h1>
                        
                        <div class="post-full-meta">
                            <time class="post-full-meta-date" datetime="{{date format="YYYY-MM-DD"}}">
                                <i class="far fa-calendar"></i> {{date format="YYYY年M月D日"}}
                            </time>
                            
                            {{#if tags}}
                                <span class="post-full-meta-tags">
                                    <i class="fas fa-tags"></i>
                                    {{#foreach tags}}
                                        <a href="{{url}}" class="tag-chip">{{name}}</a>
                                    {{/foreach}}
                                </span>
                            {{/if}}
                            
                            <span class="reading-time">
                                <i class="far fa-clock"></i> {{reading_time minute="1分" minutes="%分"}}
                            </span>
                            
                            {{#if comments}}
                                <span class="comment-count-meta">
                                    <i class="far fa-comment"></i> {{comment_count}}
                                </span>
                            {{/if}}
                        </div>
                    </div>


                    {{!-- 本文エリア --}}
                    <section class="post-full-content gh-content">
                        {{content}}
                    </section>
                </div>
            </div>

            {{!-- 読みやすさ設定パネル --}}
            <div class="reading-settings-panel">
                <button class="settings-toggle" aria-label="読みやすさ設定">
                    <i class="fas fa-cog"></i>
                </button>
                <div class="settings-content">
                    <h4 class="settings-title">読みやすさ設定</h4>
                    <div class="setting-group">
                        <label>フォント</label>
                        <div class="font-selector">
                            <button data-font="gothic" class="active">ゴシック</button>
                            <button data-font="mincho">明朝</button>
                            <button data-font="yu-gothic">游ゴシック</button>
                        </div>
                    </div>
                    <div class="setting-group">
                        <label>文字サイズ</label>
                        <div class="size-selector">
                            <button data-size="small">小</button>
                            <button data-size="medium" class="active">中</button>
                            <button data-size="large">大</button>
                        </div>
                    </div>
                </div>
            </div>
            
            {{!-- Tips/寄付セクション --}}
            <section class="support-section">
                <div class="support-card">
                    <div class="support-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3>この記事は参考になりましたか？</h3>
                    <p>もしこの記事が役に立ったら、サポートをご検討ください。<br>あなたの支援により、より良いコンテンツを作り続けることができます。</p>
                    
                    <a href="/#/portal/support" class="support-btn">
                        <i class="fas fa-donate"></i>
                        <span>サポートする</span>
                    </a>
                </div>
            </section>

            {{!-- コメント欄 --}}
            {{#if comments}}
                <section class="article-comments">
                    {{comments title="ディスカッション" count=true mode="auto" saturation=60}}
                </section>
            {{/if}}

            {{!-- 関連記事 --}}
            {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}" limit="6" as |related|}}
                {{#if related}}
                    <section class="related-posts">
                        <h2>関連記事</h2>
                        <div class="related-posts-grid">
                            {{#foreach related}}
                                <article class="related-post-card">
                                    {{#if feature_image}}
                                        <a href="{{url}}" class="related-post-image">
                                            <img src="{{feature_image}}" alt="{{title}}" loading="lazy" />
                                        </a>
                                    {{/if}}
                                    <div class="related-post-content">
                                        <h3><a href="{{url}}">{{title}}</a></h3>
                                        <p>{{excerpt words="20"}}...</p>
                                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time>
                                    </div>
                                </article>
                            {{/foreach}}
                        </div>
                    </section>
                {{/if}}
            {{/get}}

            {{!-- フッター SNSシェアボタン --}}
            <footer class="post-footer">
                <div class="share-buttons">
                    <span class="share-label">この記事をシェア:</span>
                    <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" 
                       class="share-btn twitter" target="_blank" rel="noopener">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}" 
                       class="share-btn facebook" target="_blank" rel="noopener">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}" 
                       class="share-btn linkedin" target="_blank" rel="noopener">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <button class="share-btn copy-link" data-url="{{url absolute="true"}}">
                        <i class="fas fa-link"></i>
                    </button>
                </div>
            </footer>

        </article>
    {{/post}}
</main>

<style>
/* 基本スタイル */
.site-main {
    width: 100%;
    margin: 0 auto;
    padding: 20px;
}

.post-full {
    max-width: 100%;
    margin: 0 auto;
}

/* ヘッダー部 */
.post-feature-image-wrapper {
    max-width: 800px;
    margin: 0 auto 30px;
    border-radius: 12px;
    overflow: hidden;
}

.post-full-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
}

/* メインコンテンツラッパー */
.main-content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
}

/* コンテンツエリア（タイトルと本文） */
.post-header-and-content {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

.post-header-content {
    margin-bottom: 40px;
}

.post-full-title {
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 700;
    margin: 20px 0;
    line-height: 1.3;
    color: #1a1a1a;
}

.post-full-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    color: #6b7280;
    font-size: 0.95rem;
}

.post-full-meta i {
    margin-right: 5px;
}

.tag-chip {
    display: inline-block;
    padding: 4px 12px;
    background: #f3f4f6;
    border-radius: 20px;
    margin: 0 5px;
    text-decoration: none;
    color: #4b5563;
    transition: all 0.3s;
    font-size: 0.875rem;
}

.tag-chip:hover {
    background: #e5e7eb;
    color: #1f2937;
}

/* 本文エリア */
.gh-content {
    position: relative;
}

/* PC表示時のレイアウト調整 */
@media (min-width: 1300px) {
    .main-content-wrapper {
        /* グリッドレイアウトを解除 */
    }
    
    .post-header-and-content {
        /* max-widthとmargin:autoで中央揃えを維持 */
    }
}

/* 読みやすさ設定パネル（常に右下に固定） */
.reading-settings-panel {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 100;
    transition: opacity 0.3s ease;
}

.reading-settings-panel.scrolled {
    opacity: 0.3;
}

.reading-settings-panel:hover {
    opacity: 1;
}

.settings-toggle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: all 0.3s;
}

.settings-toggle:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.settings-content {
    display: none;
    position: absolute;
    bottom: 54px;
    right: 0;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    padding: 20px;
    min-width: 220px;
    border: 1px solid #e5e7eb;
}

.settings-content.active {
    display: block;
}

.settings-title {
    margin: 0 0 16px;
    font-size: 0.95rem;
    color: #374151;
    font-weight: 600;
}

.setting-group {
    margin-bottom: 18px;
}

.setting-group:last-child {
    margin-bottom: 0;
}

.setting-group label {
    display: block;
    margin-bottom: 10px;
    font-weight: 500;
    color: #374151;
    font-size: 0.875rem;
}

.font-selector,
.size-selector {
    display: flex;
    gap: 4px;
}

.font-selector button,
.size-selector button {
    flex: 1;
    padding: 6px 8px;
    border: 1px solid #d1d5db;
    background: #fff;
    color: #374151;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.75rem;
    transition: all 0.2s;
}

.font-selector button:hover,
.size-selector button:hover {
    border-color: #9ca3af;
}

.font-selector button.active,
.size-selector button.active {
    background: #4b5563;
    color: #fff;
    border-color: #4b5563;
}

/* 本文エリア */
.post-full-content {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 60px;
    color: #1f2937;
}

.post-full-content h2 {
    margin-top: 48px;
    margin-bottom: 24px;
    font-size: 1.875rem;
    font-weight: 600;
}

.post-full-content h3 {
    margin-top: 36px;
    margin-bottom: 18px;
    font-size: 1.5rem;
    font-weight: 600;
}

/* サポートセクション */
.support-section {
    max-width: 800px;
    margin: 60px auto;
}

.support-card {
    background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
    border: 1px solid #e5e7eb;
    padding: 48px;
    border-radius: 16px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.support-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #6b7280, #9ca3af, #6b7280);
    background-size: 200% 100%;
    animation: shimmer 3s linear infinite;
}

@keyframes shimmer {
    to {
        background-position: -200% 0;
    }
}

.support-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 24px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.support-icon i {
    font-size: 28px;
    color: #ef4444;
}

.support-card h3 {
    font-size: 1.5rem;
    margin-bottom: 16px;
    color: #1f2937;
    font-weight: 600;
}

.support-card p {
    color: #6b7280;
    margin-bottom: 32px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
}

.support-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: #4b5563;
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s;
}

.support-btn:hover {
    background: #374151;
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

/* コメントセクション */
.article-comments {
    max-width: 800px;
    margin: 60px auto;
}

/* 関連記事 */
.related-posts {
    max-width: 1200px;
    margin: 60px auto;
}

.related-posts h2 {
    margin-bottom: 32px;
    font-size: 1.75rem;
    color: #1f2937;
    font-weight: 600;
    text-align: center;
}

.related-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
}

.related-post-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    transition: all 0.3s;
}

.related-post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
}

.related-post-image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.related-post-content {
    padding: 20px;
}

.related-post-content h3 {
    margin: 0 0 12px;
    font-size: 1.125rem;
    font-weight: 600;
}

.related-post-content a {
    color: #1f2937;
    text-decoration: none;
}

.related-post-content a:hover {
    color: #4b5563;
}

.related-post-content p {
    color: #6b7280;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 12px;
}

.related-post-content time {
    color: #9ca3af;
    font-size: 0.875rem;
}

/* フッター */
.post-footer {
    max-width: 800px;
    margin: 60px auto 0;
    padding: 40px 20px;
    border-top: 1px solid #e5e7eb;
}

.share-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
}

.share-label {
    font-weight: 500;
    color: #6b7280;
}

.share-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-decoration: none;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
}

.share-btn:hover {
    transform: scale(1.1) rotate(5deg);
}

.share-btn.twitter { background: #1da1f2; }
.share-btn.facebook { background: #1877f2; }
.share-btn.linkedin { background: #0077b5; }
.share-btn.copy-link { background: #6b7280; }

/* ダークモード対応 */
.dark-mode {
    background-color: #1a1a1a;
    color: #e5e5e5;
}

.dark-mode .post-full-title {
    color: #e5e5e5;
}

.dark-mode .post-full-meta {
    color: #9ca3af;
}

.dark-mode .tag-chip {
    background: #2d2d2d;
    color: #9ca3af;
    border: 1px solid #404040;
}

.dark-mode .tag-chip:hover {
    background: #404040;
    color: #e5e5e5;
}

.dark-mode .settings-toggle {
    background: #2d2d2d;
    border-color: #404040;
    color: #e5e5e5;
}

.dark-mode .settings-content {
    background: #2d2d2d;
    border-color: #404040;
}

.dark-mode .settings-title {
    color: #e5e5e5;
}

.dark-mode .setting-group label {
    color: #e5e5e5;
}

.dark-mode .font-selector button,
.dark-mode .size-selector button {
    background: #1a1a1a;
    border-color: #404040;
    color: #9ca3af;
}

.dark-mode .font-selector button:hover,
.dark-mode .size-selector button:hover {
    border-color: #6b7280;
}

.dark-mode .font-selector button.active,
.dark-mode .size-selector button.active {
    background: #6b7280;
    color: #e5e5e5;
    border-color: #6b7280;
}

.dark-mode .post-full-content {
    color: #e5e5e5;
}

.dark-mode .post-full-content h2,
.dark-mode .post-full-content h3 {
    color: #e5e5e5;
}

.dark-mode .support-card {
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
    border-color: #404040;
}

.dark-mode .support-icon {
    background: #2d2d2d;
}

.dark-mode .support-card h3 {
    color: #e5e5e5;
}

.dark-mode .support-card p {
    color: #9ca3af;
}

.dark-mode .related-post-card {
    background: #2d2d2d;
    border-color: #404040;
}

.dark-mode .related-post-content a {
    color: #e5e5e5;
}

.dark-mode .related-post-content a:hover {
    color: #9ca3af;
}

.dark-mode .related-post-content p {
    color: #9ca3af;
}

.dark-mode .related-post-content time {
    color: #6b7280;
}

.dark-mode .post-footer {
    border-top-color: #404040;
}

.dark-mode .share-label {
    color: #9ca3af;
}

/* レスポンシブ: タブレット・スマホ (1299px以下) */
@media (max-width: 1299px) {
    /* 目次関連のスタイルは削除済み */
}

/* レスポンシブ: タブレット (768px - 1299px) */
@media (min-width: 768px) and (max-width: 1299px) {
    .related-posts-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* レスポンシブ: スマホ (767px以下) */
@media (max-width: 767px) {
    .site-main {
        padding: 15px;
    }
    
    .post-full-title {
        font-size: 1.75rem;
    }
    
    .post-full-meta {
        font-size: 0.875rem;
        gap: 15px;
    }
    
    .reading-settings-panel {
        bottom: 20px;
        right: 20px;
    }
    
    .settings-toggle {
        width: 40px;
        height: 40px;
    }
    
    .settings-content {
        width: 260px;
        max-width: calc(100vw - 40px);
        bottom: 50px;
    }
    
    .post-full-content {
        font-size: 1rem;
    }
    
    .support-card {
        padding: 32px 24px;
    }
    
    .related-posts-grid {
        grid-template-columns: 1fr;
    }
    
    .share-buttons {
        flex-wrap: wrap;
    }
}

/* フォント切り替え */
body[data-font="mincho"] .post-full-content {
    font-family: "游明朝", "Yu Mincho", serif;
}

body[data-font="yu-gothic"] .post-full-content {
    font-family: "游ゴシック", "Yu Gothic", sans-serif;
}

/* 文字サイズ切り替え */
body[data-size="small"] .post-full-content {
    font-size: 0.95em;
}

body[data-size="large"] .post-full-content {
    font-size: 1.25em;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Tocbotの初期化スクリプトは削除済み
    
    const settingsPanel = document.querySelector('.reading-settings-panel');
    const settingsToggle = document.querySelector('.settings-toggle');
    const settingsContent = document.querySelector('.settings-content');
    
    // 設定パネルのトグル
    settingsToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        settingsContent?.classList.toggle('active');
    });
    
    // 外側クリックで閉じる
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.reading-settings-panel')) {
            settingsContent?.classList.remove('active');
        }
    });
    
    // スクロール時の透過処理
    let scrolling = false;
    let scrollTimer;
    
    window.addEventListener('scroll', () => {
        if (!scrolling) {
            settingsPanel?.classList.add('scrolled');
            scrolling = true;
        }
        
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
            settingsPanel?.classList.remove('scrolled');
            scrolling = false;
        }, 1500);
    });
    
    // フォント切り替え
    document.querySelectorAll('.font-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.font-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-font', btn.dataset.font);
            localStorage.setItem('preferred-font', btn.dataset.font);
        });
    });
    
    // 文字サイズ切り替え
    document.querySelectorAll('.size-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.size-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-size', btn.dataset.size);
            localStorage.setItem('preferred-size', btn.dataset.size);
        });
    });
    
    // 保存した設定を読み込み
    const savedFont = localStorage.getItem('preferred-font');
    const savedSize = localStorage.getItem('preferred-size');
    
    if (savedFont) {
        document.body.setAttribute('data-font', savedFont);
        const fontBtn = document.querySelector(`.font-selector button[data-font="${savedFont}"]`);
        if (fontBtn) {
            document.querySelectorAll('.font-selector button').forEach(b => b.classList.remove('active'));
            fontBtn.classList.add('active');
        }
    }
    
    if (savedSize) {
        document.body.setAttribute('data-size', savedSize);
        const sizeBtn = document.querySelector(`.size-selector button[data-size="${savedSize}"]`);
        if (sizeBtn) {
            document.querySelectorAll('.size-selector button').forEach(b => b.classList.remove('active'));
            sizeBtn.classList.add('active');
        }
    }
    
    // リンクコピー
    document.querySelector('.copy-link')?.addEventListener('click', function() {
        const url = this.dataset.url;
        // navigator.clipboard.writeTextがiframe内で動作しない場合があるため、代替手段を使用
        const textArea = document.createElement("textarea");
        textArea.value = url;
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
            document.execCommand('copy');
            const originalHTML = this.innerHTML;
            this.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => {
                this.innerHTML = originalHTML;
            }, 2000);
        } catch (err) {
            console.error('リンクのコピーに失敗しました', err);
        }
        document.body.removeChild(textArea);
    });
});
</script>
