{{!< default}}

<main class="site-main">
    {{#post}}
        <article class="post-full {{post_class}}">
            {{!-- ヘッダー部 --}}
            <header class="post-full-header">
                {{#if feature_image}}
                    <div class="post-feature-image-wrapper">
                        <img class="post-full-image" src="{{feature_image}}" alt="{{title}}" />
                    </div>
                {{/if}}
            </header>

            <div class="main-content-wrapper">
                <div class="post-header-and-content">
                    <div class="post-header-content">
                        <h1 class="post-full-title">{{title}}</h1>
                        
                        <div class="post-full-meta">
                            <time class="post-full-meta-date" datetime="{{date format="YYYY-MM-DD"}}">
                                <i class="far fa-calendar"></i> {{date format="YYYY年M月D日"}}
                            </time>
                            
                            {{#if tags}}
                                <span class="post-full-meta-tags">
                                    <i class="fas fa-tags"></i>
                                    {{#foreach tags}}
                                        <a href="{{url}}" class="tag-chip">{{name}}</a>
                                    {{/foreach}}
                                </span>
                            {{/if}}
                            
                            <span class="reading-time">
                                <i class="far fa-clock"></i> {{reading_time minute="1分" minutes="%分"}}
                            </span>
                            
                            {{#if comments}}
                                <span class="comment-count-meta">
                                    <i class="far fa-comment"></i> {{comment_count}}
                                </span>
                            {{/if}}
                        </div>
                    </div>

                    {{!-- 本文エリア --}}
                    <section class="post-full-content gh-content">
                        {{{content}}}
                    </section>
                </div>
            </div>

            {{!-- 読みやすさ設定パネル --}}
            <div class="reading-settings-panel">
                <button class="settings-toggle" aria-label="読みやすさ設定">
                    <i class="fas fa-cog"></i>
                </button>
                <div class="settings-content">
                    <h4 class="settings-title">読みやすさ設定</h4>
                    <div class="setting-group">
                        <label>フォント</label>
                        <div class="font-selector">
                            <button data-font="noto-sans" class="active">ゴシック</button>
                            <button data-font="noto-serif">明朝</button>
                            <button data-font="rounded-mplus">丸ゴシック</button>
                        </div>
                    </div>
                    <div class="setting-group">
                        <label>文字サイズ</label>
                        <div class="size-selector">
                            <button data-size="small">小</button>
                            <button data-size="medium" class="active">中</button>
                            <button data-size="large">大</button>
                        </div>
                    </div>
                    <div class="setting-group">
                         <button class="scroll-to-top-btn">
                            <i class="fas fa-arrow-up"></i> TOPへ戻る
                        </button>
                    </div>
                </div>
            </div>
            
            {{!-- Tips/寄付セクション --}}
            <section class="support-section">
                
                <!-- アイコンをFont AwesomeからインラインSVGに変更 -->
                <svg class="support-icon-svg" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>

                <h3 class="support-title">この記事は参考になりましたか？</h3>
                <p class="support-description">
                    もしこの記事が役に立ったら、サポートをご検討ください。<br>
                    あなたの支援により、より良いコンテンツを作り続けることができます。
                </p>
                
                <a href="/#/portal/support" class="support-btn">
                    <!-- ボタン内のアイコンもSVGに変更 -->
                    <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                    </svg>
                    <span>サポートする</span>
                </a>

            </section>

            {{!-- コメント欄 --}}
            {{#if comments}}
                <section class="article-comments">
                    <div class="article-comments-container">
                        <h2 class="article-comments-title">GUEST BOOK</h2>
                        <div class="article-comments-meta">
                            {{! コメント数をシンプルに表示 }}
                            {{comment_count singular="1 Comment" plural="% Comments" empty="No Comments Yet" autowrap="span" class="comment-count-text"}}
                        </div>
                        
                        {{! Ghostのコメント機能本体（タイトルとカウントは非表示に） }}
                        {{comments title="" count=false}}
                    </div>
                </section>
            {{/if}}

            {{! --- 関連記事 --- }}
            {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}" limit="6" as |related_posts|}}
                {{#if related_posts}}
                    <section class="critique-section related-posts">
                        <h2 class="section-title">関連記事</h2>
                        <div class="post-feed">
                            {{#foreach related_posts}}
                                {{!-- 「批評・レビュー」と同じカードデザインを適用 --}}
                                <a href="{{url}}" class="post-card">
                                    {{#if feature_image}}
                                        <div class="post-card-image-wrapper">
                                            <img class="post-card-image" src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                                            {{#match visibility "!=" "public"}}
                                                <div class="premium-indicator">
                                                    <i class="fas fa-lock"></i>
                                                </div>
                                            {{/match}}
                                        </div>
                                    {{/if}}
                                    <div class="post-card-content">
                                        <h2 class="post-card-title">{{title}}</h2>
                                        <p class="post-card-excerpt">{{excerpt}}</p>
                                        <footer class="post-card-meta">
                                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time>
                                            {{#if reading_time}}
                                                <span> | {{reading_time}}</span>
                                            {{/if}}
                                        </footer>
                                    </div>
                                </a>
                            {{/foreach}}
                        </div>
                    </section>
                {{/if}}
            {{/get}}

            {{!-- フッター SNSシェアボタン --}}
            <footer class="post-footer">
                <div class="share-buttons">
                    <span class="share-label">この記事をシェア:</span>
                    <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" 
                       class="share-btn twitter" target="_blank" rel="noopener">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}" 
                       class="share-btn facebook" target="_blank" rel="noopener">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}" 
                       class="share-btn linkedin" target="_blank" rel="noopener">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <button class="share-btn copy-link" data-url="{{url absolute="true"}}">
                        <i class="fas fa-link"></i>
                    </button>
                </div>
            </footer>

        </article>
    {{/post}}

                        

</main>

<style>

</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    const settingsPanel = document.querySelector('.reading-settings-panel');
    const settingsToggle = document.querySelector('.settings-toggle');
    const settingsContent = document.querySelector('.settings-content');
    
    // 設定パネルのトグル
    settingsToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        settingsContent?.classList.toggle('active');
    });
    
    // 外側クリックで閉じる
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.reading-settings-panel')) {
            settingsContent?.classList.remove('active');
        }
    });
    
    // スクロール時の透過処理（修正版）
    let scrollTimer;
    window.addEventListener('scroll', () => {
        // ページトップにいる場合は、クラスを削除して不透明にする
        if (window.scrollY <= 20) {
            settingsPanel?.classList.remove('scrolled');
            clearTimeout(scrollTimer);
            return;
        }

        // スクロール中はクラスを追加して半透明にする
        settingsPanel?.classList.add('scrolled');
        
        // スクロールが止まったら1.5秒後に不透明に戻すためのタイマー
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
            settingsPanel?.classList.remove('scrolled');
        }, 1500);
    });
    
    // フォント切り替え
    document.querySelectorAll('.font-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.font-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-font', btn.dataset.font);
            localStorage.setItem('preferred-font', btn.dataset.font);
        });
    });
    
    // 文字サイズ切り替え
    document.querySelectorAll('.size-selector button').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.size-selector button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.body.setAttribute('data-size', btn.dataset.size);
            localStorage.setItem('preferred-size', btn.dataset.size);
        });
    });
    
    // 保存した設定を読み込み
    const savedFont = localStorage.getItem('preferred-font') || 'noto-sans';
    const savedSize = localStorage.getItem('preferred-size') || 'medium';
    
    document.body.setAttribute('data-font', savedFont);
    const fontBtn = document.querySelector(`.font-selector button[data-font="${savedFont}"]`);
    if (fontBtn) {
        document.querySelectorAll('.font-selector button').forEach(b => b.classList.remove('active'));
        fontBtn.classList.add('active');
    }
    
    document.body.setAttribute('data-size', savedSize);
    const sizeBtn = document.querySelector(`.size-selector button[data-size="${savedSize}"]`);
    if (sizeBtn) {
        document.querySelectorAll('.size-selector button').forEach(b => b.classList.remove('active'));
        sizeBtn.classList.add('active');
    }
    
    // リンクコピー
    document.querySelector('.copy-link')?.addEventListener('click', function() {
        const url = this.dataset.url;
        const textArea = document.createElement("textarea");
        textArea.value = url;
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
            document.execCommand('copy');
            const originalHTML = this.innerHTML;
            this.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => {
                this.innerHTML = originalHTML;
            }, 2000);
        } catch (err) {
            console.error('リンクのコピーに失敗しました', err);
        }
        document.body.removeChild(textArea);
    });

    // TOPへ戻るボタン
    document.querySelector('.scroll-to-top-btn')?.addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
        settingsContent?.classList.remove('active');
    });
});
</script>

<style>
    // フッターを非表示にする
    .site-footer {
        display: none;
    }
</style>
